# Copie para `.env` na raiz do repositorio e ajuste:
#
#     cp env.example .env
#
# (o arquivo se chama `env.example` sem ponto de proposito, para nao ser
# escondido nem confundido com o `.env` de verdade; o `.env` NUNCA e commitado
# — ver .gitignore)
#
# Chave de API commitada e criterio de REPROVACAO (regra R15). Se voce commitar
# uma por acidente: revogue a chave no provedor PRIMEIRO, depois limpe o
# historico. Trocar o arquivo no commit seguinte nao adianta — o valor continua
# no historico do Git para sempre.

DJANGO_SECRET_KEY=troque-isto-por-qualquer-coisa-longa
DJANGO_DEBUG=1

POSTGRES_DB=financials
POSTGRES_USER=financials
POSTGRES_PASSWORD=financials
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/1

FINANCIALS_STORAGE_ROOT=/app/var/uploads

# Provider de extracao ativo: naive | rule_based | llm
# `naive` e o piso (nao extrai nada). Troque quando o seu provider existir.
FINANCIALS_EXTRACTION_PROVIDER=naive

# ── Provedor de LLM (Sprint 3) ───────────────────────────────────────────────
# Preencha SO o do provedor que voce escolheu. O codigo le por os.environ, e
# apenas de dentro de services/extraction/providers/.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
